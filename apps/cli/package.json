{
  "name": "relic-bridge",
  "version": "0.11.0",
  "mcpName": "io.github.mhidalgo-lab/relic-bridge",
  "description": "Unofficial MCP server for New Relic via NerdGraph: query telemetry from AI agents with a User API key",
  "license": "Apache-2.0",
  "author": "Matias Hidalgo",
  "homepage": "https://github.com/mhidalgo-lab/relic-bridge#readme",
  "bugs": {
    "url": "https://github.com/mhidalgo-lab/relic-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhidalgo-lab/relic-bridge.git",
    "directory": "apps/cli"
  },
  "type": "module",
  "bin": {
    "relic-bridge": "./dist/index.mjs"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "new-relic",
    "nerdgraph",
    "nrql",
    "observability",
    "ai-agents"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "relicBridge": {
    "runtime": "node"
  },
  "dependencies": {
    "@hono/node-server": "2.1.3",
    "@modelcontextprotocol/server": "2.2.0",
    "hono": "4.13.11",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@relic-bridge/admin-ui": "workspace:*",
    "@relic-bridge/auth": "workspace:*",
    "@relic-bridge/core": "workspace:*",
    "@relic-bridge/http-app": "workspace:*",
    "@relic-bridge/storage": "workspace:*",
    "@relic-bridge/storage-sqlite": "workspace:*",
    "fast-check": "4.10.2",
    "tsdown": "0.23.0"
  }
}
