{
  "name": "relic-bridge",
  "version": "0.0.0",
  "description": "Unofficial MCP server for New Relic via NerdGraph (CLI: stdio and serve)",
  "license": "Apache-2.0",
  "private": false,
  "type": "module",
  "bin": {
    "relic-bridge": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "relicBridge": {
    "runtime": "node"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.2.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.2.0",
    "@relic-bridge/core": "workspace:*",
    "tsdown": "0.23.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "new-relic",
    "nerdgraph",
    "nrql",
    "observability",
    "ai-agents"
  ],
  "engines": {
    "node": ">=24.11.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matiashidalgo/relic-bridge.git",
    "directory": "apps/cli"
  }
}
