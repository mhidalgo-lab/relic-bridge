{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Bin-only package (no published types), so declaration-level checks don't apply.
    "declaration": false,
    "isolatedDeclarations": false,
    "paths": {
      "@relic-bridge/auth": ["../../packages/auth/src/index.ts"],
      "@relic-bridge/core": ["../../packages/core/src/index.ts"],
      "@relic-bridge/http-app": ["../../packages/http-app/src/index.ts"],
      "@relic-bridge/storage": ["../../packages/storage/src/index.ts"],
      "@relic-bridge/storage-sqlite": ["../../packages/storage-sqlite/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
