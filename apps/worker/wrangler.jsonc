// relic-bridge on Cloudflare Workers (P3-01). No account or resource ids are committed: `wrangler dev` uses local
// resources, and Wrangler's automatic provisioning creates D1/KV on the first deploy (P3-05 documents the setup).
// Secrets (`RB_MASTER_KEY`, `RB_ADMIN_TOKEN`) come from `wrangler secret put` or a local `.dev.vars`, never `vars`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relic-bridge",
  "main": "src/index.ts",
  // Latest date the pinned workerd supports. No `nodejs_compat`: every package is web-standard (ADR-0004).
  "compatibility_date": "2026-09-26",
  // Part of the SSRF guard for OAuth client metadata documents (P5-03, ADR-0012): `fetch` routes as on the public
  // internet (our own zone through Cloudflare's front door, never straight to the origin). Every other outbound call
  // (NerdGraph, sign-in providers) goes to the public internet anyway.
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "send_metrics": false,
  "observability": { "enabled": true },
  // Build from the workspace sources (no `pnpm build` needed before `wrangler dev`).
  "alias": {
    "@relic-bridge/admin-ui": "../../packages/admin-ui/src/index.ts",
    "@relic-bridge/auth": "../../packages/auth/src/index.ts",
    "@relic-bridge/core": "../../packages/core/src/index.ts",
    "@relic-bridge/http-app": "../../packages/http-app/src/index.ts",
    "@relic-bridge/storage/d1": "../../packages/storage/src/d1.ts",
    "@relic-bridge/storage": "../../packages/storage/src/index.ts"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "relic-bridge" }],
  // Reserved and unused: OAuth provider state lives in D1 (ADR-0011). See docs/pending-decisions/phase-5.md.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Workers Rate Limiting (P3-04). `namespace_id` is any account-unique integer string, not a secret.
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1701", "simple": { "limit": 600, "period": 60 } }
  ],
  // Audit retention (P3-08): hourly like `relic-bridge serve`; deletes rows older than RB_AUDIT_RETENTION_DAYS.
  "triggers": { "crons": ["17 * * * *"] },
  "secrets": { "required": ["RB_MASTER_KEY", "RB_ADMIN_TOKEN"] },
  "vars": { "RB_PLAN": "free" }
}
