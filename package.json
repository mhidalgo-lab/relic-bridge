{
  "name": "relic-bridge-monorepo",
  "private": true,
  "description": "Unofficial MCP server for New Relic via NerdGraph — monorepo root",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "typecheck": "tsc -p scripts && tsc -p e2e && pnpm -r run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --project=!worker",
    "test:workers": "vitest run --project worker",
    "test:authz": "vitest run --project http-app test/authz",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "scan:zap": "node e2e/zap.ts",
    "e2e:screenshots": "RB_E2E_SCREENSHOTS=1 playwright test -c e2e/playwright.config.ts --project=desktop --project=mobile-320",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "lint": "biome check . && node scripts/check-runtime-imports.ts && node scripts/check-nrql-templates.ts && node scripts/check-ui-escaping.ts && node scripts/check-spdx.ts && node scripts/tasks.ts check && node scripts/gen-tool-docs.ts --check && node scripts/gen-migrations.ts --check && node scripts/gen-db-fixtures.ts --check && node scripts/gen-admin-assets.ts --check && node scripts/gen-app-assets.ts --check && node scripts/release.ts sync-version --check && node scripts/release.ts check-changesets",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "tasks": "node scripts/tasks.ts",
    "bench": "node scripts/bench-tools.ts",
    "bench:cpu": "node scripts/bench-cpu.ts",
    "eval:tools": "node scripts/eval-tools.ts",
    "cf:setup": "node scripts/cloudflare-setup.ts",
    "docs:site": "pnpm --filter relic-bridge-docs-site build",
    "docs:check": "pnpm docs:site && pnpm --filter relic-bridge-docs-site check:links",
    "docs:tools": "node scripts/gen-tool-docs.ts",
    "nerdgraph:schema": "node scripts/nerdgraph-schema.ts",
    "ui:assets": "node scripts/gen-admin-assets.ts",
    "app:assets": "node scripts/gen-app-assets.ts",
    "docs:admin-api": "vitest run --project http-app test/admin-docs.test.ts -u",
    "changeset": "changeset",
    "prepare": "lefthook install || true",
    "version-packages": "changeset version && node scripts/release.ts sync-version && node scripts/gen-db-fixtures.ts --next-release",
    "check:package": "node scripts/check-package.ts",
    "db:generate": "pnpm --filter @relic-bridge/storage db:generate",
    "db:fixtures": "node scripts/gen-db-fixtures.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.63.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "4.1.11",
    "graphql": "17.0.2",
    "jsdom": "30.1.1",
    "lefthook": "2.1.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
