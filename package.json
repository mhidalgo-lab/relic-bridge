{
  "name": "relic-bridge-monorepo",
  "private": true,
  "description": "Unofficial MCP server for New Relic via NerdGraph \u2014 monorepo root",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "typecheck": "tsc -p scripts && pnpm -r run typecheck",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "lint": "biome check . && node scripts/check-runtime-imports.ts && node scripts/check-nrql-templates.ts && node scripts/check-spdx.ts && node scripts/tasks.ts check && node scripts/gen-tool-docs.ts --check && node scripts/gen-migrations.ts --check && node scripts/release.ts sync-version --check",
    "format": "biome format --write .",
    "lint:fix": "biome check --write .",
    "tasks": "node scripts/tasks.ts",
    "docs:tools": "node scripts/gen-tool-docs.ts",
    "changeset": "changeset",
    "prepare": "lefthook install || true",
    "version-packages": "changeset version && node scripts/release.ts sync-version",
    "check:package": "node scripts/check-package.ts",
    "db:generate": "pnpm --filter @relic-bridge/storage db:generate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@changesets/cli": "3.0.3",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "4.1.11",
    "lefthook": "2.1.14",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "yaml": "2.9.1"
  }
}
