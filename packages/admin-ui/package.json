{
  "name": "@relic-bridge/admin-ui",
  "version": "0.0.0",
  "description": "Server-rendered admin panel (Hono JSX, strict CSP)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "relicBridge": {
    "runtime": "web"
  },
  "dependencies": {
    "hono": "4.13.11"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "axe-core": "4.14.0",
    "jsdom": "30.1.2",
    "tsdown": "0.23.1"
  }
}
