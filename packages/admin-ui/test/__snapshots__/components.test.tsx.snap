exports[`forms > snapshot: form with an error 1`] = `"<!doctype html><form method="post" action="/admin/credentials"><input type="hidden" name="_csrf" value="tok"/><div class="field"><label for="label">Label</label><p class="error" id="label-error">Required.</p><input id="label" name="label" type="text" aria-invalid="true" aria-describedby="label-error"/></div></form>"`;

exports[`layout > snapshot: signed-in layout 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><meta name="referrer" content="no-referrer"/><meta name="color-scheme" content="light dark"/><title>Overview · relic-bridge</title><link rel="stylesheet" href="/admin/assets/admin.<hash>.css" integrity="sha384-<css>"/><script src="/admin/assets/admin.<hash>.js" integrity="sha384-<js>" defer=""></script></head><body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="bar"><a class="brand" href="/admin">relic-bridge</a><nav class="nav" aria-label="Main"><ul><li><a href="/admin" aria-current="page">Overview</a></li><li><a href="/admin/credentials">Keys</a></li><li><a href="/admin/projects">Projects</a></li><li><a href="/admin/grants">Grants</a></li><li><a href="/admin/tokens">Devices</a></li><li><a href="/admin/connect">Connect</a></li><li><a href="/admin/users">Users</a></li><li><a href="/admin/audit">Audit</a></li><li><a href="/admin/usage">Usage</a></li></ul></nav></div></header><main id="main" tabindex="-1"><h1>Overview</h1></main><footer class="site-footer"><div class="bar"><span>Signed in as <strong>admin@example.com</strong> (admin)</span><form method="post" action="/auth/logout"><input type="hidden" name="_csrf" value="ADMIN-ccccccccccccccccccccccccccccccccccccc"/><button type="submit" class="button button-secondary">Sign out</button></form></div></footer></body></html>"`;

exports[`pages > login page lists the providers as links, and says when a setup link is in use 1`] = `"<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex, nofollow"/><meta name="referrer" content="no-referrer"/><meta name="color-scheme" content="light dark"/><title>Sign in · relic-bridge</title><link rel="stylesheet" href="/admin/assets/admin.<hash>.css" integrity="sha384-<css>"/><script src="/admin/assets/admin.<hash>.js" integrity="sha384-<js>" defer=""></script></head><body><a class="skip-link" href="#main">Skip to content</a><header class="site-header"><div class="bar"><a class="brand" href="/auth/login">relic-bridge</a></div></header><main id="main" tabindex="-1"><h1>Sign in</h1><ul class="providers" aria-label="Sign-in providers"><li><a class="button" href="/auth/login/github?next=%2Fadmin">Sign in with GitHub</a></li><li><a class="button" href="/auth/cf-access">Sign in with Cloudflare Access</a></li></ul></main><footer class="site-footer"><div class="bar"><span>relic-bridge admin</span></div></footer></body></html>"`;
