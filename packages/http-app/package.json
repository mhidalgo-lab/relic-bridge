{
  "name": "@relic-bridge/http-app",
  "version": "0.0.0",
  "description": "Hono HTTP app: MCP endpoints, admin API, OAuth routes",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json"
  },
  "relicBridge": {
    "runtime": "web"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "1.2.3",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/server": "2.3.1",
    "@relic-bridge/admin-ui": "workspace:*",
    "@relic-bridge/auth": "workspace:*",
    "@relic-bridge/core": "workspace:*",
    "@relic-bridge/storage": "workspace:*",
    "hono": "4.13.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "fast-check": "4.10.2",
    "tsdown": "0.23.1"
  }
}
