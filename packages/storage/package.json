{
  "name": "@relic-bridge/storage",
  "version": "0.0.0",
  "description": "Storage interface and adapters (YAML, SQLite, D1)",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./d1": {
      "types": "./dist/d1.d.mts",
      "default": "./dist/d1.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "default": "./dist/schema.mjs"
    },
    "./testing": {
      "types": "./dist/testing.d.mts",
      "default": "./dist/testing.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/sqlite/tsconfig.json",
    "db:generate": "drizzle-kit generate && node ../../scripts/gen-migrations.ts"
  },
  "relicBridge": {
    "runtime": "web"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.11",
    "tsdown": "0.23.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
