// P0-08 spike Worker. Local only (`pnpm dev:worker`); see deploy-and-test.md before deploying.
{
  "name": "relic-bridge-spike-oauth",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  // Required for CIMD (SSRF protection on outbound metadata fetches).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "spike-local-oauth-kv" }],
  "workers_dev": true
}
